# Copiar este archivo como backend/.env y completar los valores.
# backend/.env no se sube al repositorio (tiene contraseñas).
# Todas las claves son opcionales: las que falten toman el valor por defecto
# de src/main/resources/application.properties.

# --- Base de datos ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=seyco
DB_USER=postgres
DB_PASS=1234

# --- Aplicación ---
# URL pública del frontend (se usa en el link del correo de recuperación)
APP_URL=http://localhost:4200

# --- Correo (SMTP) ---
# Sin MAIL_HOST no se envían correos: el link de recuperación se muestra en el log del backend.
# Gmail: MAIL_PASS debe ser una "contraseña de aplicación" (requiere verificación en 2 pasos)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Seyco S.A
